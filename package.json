{
  "name": "clover",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "qa:critical": "npm run qa:critical-page-loading --workspace=web",
    "qa:data-engine": "npm run qa:data-engine-safety --workspace=web && npm run qa:data-engine-validation --workspace=web",
    "qa:browser": "npm run qa:browser-compatibility --workspace=web"
  }
}
