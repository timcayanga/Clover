{
  "name": "clover-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@clerk/expo": "^4.6.5",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.21",
    "expo-auth-session": "~57.0.11",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "check:dependencies": "expo install --check",
    "build:bundles": "expo export --platform ios --platform android --output-dir dist/native --max-workers 2",
    "build:preview": "expo export --platform web --output-dir dist/web --max-workers 2",
    "serve:preview": "node scripts/serve-preview.mjs",
    "build:ios": "expo run:ios",
    "build:android": "expo run:android",
    "check:toolchains": "node scripts/check-toolchains.mjs"
  },
  "private": true
}
